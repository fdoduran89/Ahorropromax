<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <display-name>AhorroPromax - Banco BBC</display-name>

    <!-- Servlet de Empresas -->
    <servlet>
        <servlet-name>ServletCliente</servlet-name>
        <servlet-class>com.mycompany.ahorropromax.controlador.ServClienteCorporativo</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletCliente</servlet-name>
        <url-pattern>/empresa/*</url-pattern>
    </servlet-mapping>

    <!-- Servlet de Empleados -->
    <servlet>
        <servlet-name>ServletEmpleado</servlet-name>
        <servlet-class>com.mycompany.ahorropromax.controlador.ServEmpleadoCorporativo</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletEmpleado</servlet-name>
        <url-pattern>/empleado/*</url-pattern>
    </servlet-mapping>

    <!-- Servlet de Créditos -->
    <servlet>
        <servlet-name>ServletCredito</servlet-name>
        <servlet-class>com.mycompany.ahorropromax.controlador.ServCredito</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletCredito</servlet-name>
        <url-pattern>/credito/*</url-pattern>
    </servlet-mapping>

    <!-- Servlet de Prueba -->
    <servlet>
        <servlet-name>ServletPrueba</servlet-name>
        <servlet-class>com.mycompany.ahorropromax.controlador.ServPruebaConexion</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ServletPrueba</servlet-name>
        <url-pattern>/prueba-conexion</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>